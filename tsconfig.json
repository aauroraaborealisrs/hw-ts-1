{
  "compilerOptions": {
    "target": "ES2020", // какой JS генерить (современный синтаксис)
    "module": "CommonJS", // система модулей
    "strict": true, // включает весь strict-режим сразу
    "noImplicitAny": true, // чтобы ts не подставлял any автоматически
    "strictNullChecks": true, // null и undefined считаются отдельными типами
    "noEmitOnError": true, // не генерить js если есть ошибки типов
    "esModuleInterop": true, // норм импорт commonjs модулей
    "skipLibCheck": true, // не проверять типы в node_modules
    "forceConsistentCasingInFileNames": true, // чтобы не было проблем с регистром файлов
    "noUnusedLocals": true, // ругаться если есть неиспользуемые переменные
    "noUnusedParameters": true, // ругаться если есть неиспользуемые аргументы
    "isolatedModules": true, // чтобы каждый файл компилился независимо
    "declaration": true, // для автогена .d.ts
    "outDir": "./dist", // куда складывать скомпилированные файлы
    "rootDir": "./src" // где лежат исходные ts файлы
  },
  "include": ["src/**/*"] // брать только файлы из src
}